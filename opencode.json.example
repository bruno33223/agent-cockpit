{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/auto",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai",
      "name": "OmniRoute Gateway",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "your-api-key-here"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto Router"
        }
      }
    }
  },
  "mcp": {
    "agent-cockpit": {
      "type": "local",
      "command": [
        "python3",
        "server/mcp_server.py"
      ],
      "enabled": true
    }
  }
}
