{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/auto",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai",
      "name": "OmniRoute Gateway",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "omniroute-local"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto Router"
        }
      }
    }
  },
  "mcp": {
    "agent-cockpit": {
      "type": "local",
      "command": [
        "/usr/bin/python3",
        "/home/bruno/Projects/agent-cockpit/server/mcp_server.py"
      ],
      "enabled": true
    }
  }
}