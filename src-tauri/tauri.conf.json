{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Cockpit",
  "version": "1.0.0",
  "identifier": "com.agentcockpit.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Cockpit",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
